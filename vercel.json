{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "prisma generate && next build",
  "functions": {
    "src/app/api/v1/[...path]/route.ts": {
      "maxDuration": 60
    },
    "src/app/v1/[...path]/route.ts": {
      "maxDuration": 60
    },
    "src/app/gw/v1/[...path]/route.ts": {
      "maxDuration": 60
    },
    "src/app/proxy/v1/[...path]/route.ts": {
      "maxDuration": 60
    }
  }
}
